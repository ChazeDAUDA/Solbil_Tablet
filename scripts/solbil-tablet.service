# Starter dashboardet automatisk ved boot, direkte på skærmen uden skrivebord.
# Installeres af:  sudo scripts/autostart.sh on
# Log:             journalctl -u solbil-tablet -f
# Stop/start:      sudo systemctl stop solbil-tablet   /   sudo systemctl start solbil-tablet
[Unit]
Description=Solbil dashboard
# Vent til opstartsbilledet (Plymouth) har sluppet skærmen
After=systemd-user-sessions.service plymouth-quit-wait.service
# Dashboardet overtager skærmen i stedet for login-prompten på tty1
Conflicts=getty@tty1.service

[Service]
User=solarcarpi
SupplementaryGroups=video render input gpio
WorkingDirectory=/home/solarcarpi/solbil-tablet
# SDL tegner direkte på skærmen (KMS/DRM), da der ikke kører et skrivebord
Environment=SDL_VIDEODRIVER=kmsdrm
# '+' = køres som root (ip link kræver det), '-' = fortsæt selv om CAN-hardwaren mangler
ExecStartPre=-+/home/solarcarpi/solbil-tablet/scripts/setup_can.sh
ExecStart=/home/solarcarpi/solbil-tablet/build/solbil-tablet
# Går programmet ned eller lukkes, startes det igen
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
